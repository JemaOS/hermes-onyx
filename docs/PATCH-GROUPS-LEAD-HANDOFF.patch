+def _lead_member(room: sqlite3.Row, member_id: str | None) -> dict[str, Any] | None:
+    """The ``lead`` object of a ``groups.lead`` answer: the roster's own label (spec 2)."""
+    if member_id is None:
+        return None
+    member = _room_member(room, member_id)
