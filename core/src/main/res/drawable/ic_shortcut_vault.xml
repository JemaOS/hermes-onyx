<?xml version="1.0" encoding="utf-8"?>
<!--
  « Coffre de secrets » : la tuile du menu d'appui long sur l'icône.

  Même forme que les trois autres (carré à coins arrondis, glyphe dans le disque de sûreté : son
  point le plus éloigné du centre est à 34,1 sur 108, soit 63 % du rayon du cercle inscrit — un
  masque circulaire ne le rogne donc pas), même famille de couleur — un quatrième pas de l'accent
  (`#6E9BFF`), pour que le rôle se distingue sans sortir de la palette.

  La tuile est **retirée à l'exécution** quand la sonde prouve que le serveur ne sert pas le
  greffon `onyx-vault` (`VaultShortcut.sync`) : une entrée absente plutôt qu'un tap mort.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:pathData="M24,0 H84 A24,24 0 0 1 108,24 V84 A24,24 0 0 1 84,108 H24 A24,24 0 0 1 0,84 V24 A24,24 0 0 1 24,0 Z"
        android:fillColor="#FF6E9BFF" />
    <!-- L'anse du cadenas -->
    <path
        android:pathData="M44,52 V44 A10,10 0 0 1 64,44 V52"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:fillColor="@android:color/transparent" />
    <!-- Le corps -->
    <path
        android:pathData="M40,52 H68 A6,6 0 0 1 74,58 V78 A6,6 0 0 1 68,84 H40 A6,6 0 0 1 34,78 V58 A6,6 0 0 1 40,52 Z"
        android:fillColor="#FFFFFFFF" />
    <!-- Le trou de la clé -->
    <path
        android:pathData="M54,64 A4,4 0 1 1 53.99,64 Z"
        android:fillColor="#FF6E9BFF" />
</vector>
