<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:name="android.hardware.type.automotive"
        android:required="false" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="${onyxNamespace}.permission.AUTO_SETTINGS" />

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_onyx_graphite"
        android:label="@string/auto_app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.OnyxCar">

        <meta-data
            android:name="androidx.car.app.minCarApiLevel"
            android:value="1" />

        <!--
          La voiture : uniquement la voix. On dit « demande à Onyx … », la réponse s'affiche et
          se lit. C'est le pendant Android de la conduite voix seule de la référence.
        -->
        <service
            android:name=".OnyxCarAppService"
            android:exported="true"
            android:label="@string/auto_app_name">
            <intent-filter>
                <action android:name="androidx.car.app.CarAppService" />
                <!--
                  `androidx.car.app.category.ASSISTANT` n'existe pas : Android Auto ne liste que
                  NAVIGATION, POI, IOT, WEATHER, MEDIA, MESSAGING, CALLING, SETTINGS
                  (developer.android.com/training/cars/apps/library/set-up-project). Une catégorie
                  inventée = app jamais proposée dans la voiture. Un agent à qui on parle et qui
                  répond est un échange de messages courts : MESSAGING est la catégorie qui porte
                  les gabarits de conversation (et la relecture à voix haute).
                -->
                <category android:name="androidx.car.app.category.MESSAGING" />
            </intent-filter>
        </service>

    </application>

</manifest>
