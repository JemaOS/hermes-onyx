.permission.POST_NOTIFICATIONS"}, {"name": "android.permission.POST_PROMOTED_NOTIFICATIONS"}, {"name": "android.permission.FOREGROUND_SERVICE"}, {"name": "android.permission.FOREGROUND_SERVICE_DATA_SYNC"}, {"name": "android.permission.READ_CALENDAR"}, {"name": "android.permission.WRITE_CALENDAR"}, {"name": "android.permission.READ_CONTACTS"}, {"name": "android.permission.READ_MEDIA_IMAGES"}, {"name": "android.permission.USE_BIOMETRIC"}, {"name": "android.permission.USE_FULL_SCREEN_INTENT"}, {"name": "android.permission.USE_FINGERPRINT"}, {"name": "android.permission.WAKE_LOCK"}, {"name": "android.permission.RECEIVE_BOOT_COMPLETED"}, {"name": "com.onyx.app.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"}]}}}}, "com.onyx.app.auto": {"metadata": {"added": 1794002548000, "categories": ["Internet"], "issueTracker": "https://github.com/JemaOS/hermes-onyx/issues", "lastUpdated": 1795694110000, "license": "MIT", "sourceCode": "https://github.com/JemaOS/hermes-onyx", "webSite": "https://github.com/JemaOS/hermes-onyx", "authorName": "JemaOS", "name": {"en-US": "Onyx Auto"}, "summary": {"en-US": "Android Auto companion for Onyx"}, "description": {"en-US": "The Android Auto companion for Hermes Onyx: your conversations on the car screen,\nread aloud. It only works with the main Onyx app installed.\n\nNo account, no telemetry: the app talks to the Hermes server you run yourself."}, "preferredSigner": "1a1f8225f509167b4e01d4606b5ffa6eb17c07868d9b8190efc9f47c459a4402"}, "versions": {"590a5705e28c6e3f03fc365fa8a8b1f57a4b3a8efef68d9df5dd31416df4bf09": {"added": 1795694110000, "file": {"name": "/auto-release.apk", "sha256": "590a5705e28c6e3f03fc365fa8a8b1f57a4b3a8efef68d9df5dd31416df4bf09", "size": 12892921}, "manifest": {"nativecode": ["arm64-v8a", "armeabi-v7a", "x86", "x86_64"], "versionName": "1.3.99", "versionCode": 1231, "usesSdk": {"minSdkVersion": 26, "targetSdkVersion": 36}, "signer": {"sha256": ["1a1f8225f509167b4e01d4606b5ffa6eb17c07868d9b8190efc9f47c459a4402"]}, "usesPermission