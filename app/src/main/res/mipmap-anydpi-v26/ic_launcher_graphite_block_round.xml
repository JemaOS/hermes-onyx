<?xml version="1.0" encoding="utf-8"?>
<!--
  La variante ronde de l'icône adaptative de l'alias actif (`roundIcon` de `GraphiteBlock`).
  Mêmes trois couches que `ic_launcher_graphite_block.xml`.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_adaptive_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_adaptive_monochrome" />
</adaptive-icon>
