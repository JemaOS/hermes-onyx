<?xml version="1.0" encoding="utf-8"?>
<!--
  L'ICÔNE ADAPTATIVE de l'alias de lanceur actif, `com.onyx.app/.launcher.GraphiteBlock` : c'est
  cette ressource que le tiroir d'applications lit réellement. Le manifeste la déclare toujours
  sous le nom `@mipmap/ic_launcher_graphite_block` — la ressource ne change pas de nom, elle
  change de nature sur Android 8.0 et plus : fond + premier plan + monochrome au lieu d'une
  bitmap réduite sur la plaque blanche du lanceur. Les PNG par densité restent en repli.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_adaptive_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_adaptive_monochrome" />
</adaptive-icon>
