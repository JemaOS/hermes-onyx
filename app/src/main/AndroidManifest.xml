        <!-- Le tour en cours, suivi dans la barre d'état (Live Update sur Android 16). -->
        <service
            android:name=".notifications.TurnService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!--
          La veille d'appel : le service de premier plan qui garde Onyx joignable quand l'app
          n'est pas au premier plan — c'est la seule façon dont Android laisse une app écouter hors
          de vue (le `VoiceCallService` de la référence). Sans lui, un `phone_call_me` lancé alors
          que l'écran est éteint ne sonnerait jamais.
        -->
        <service
            android:name=".notifications.AgentCallService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Les boutons « Approve » / « Deny » d'une notification d'approbation. -->
        <receiver
            android:name=".notifications.ApprovalActionReceiver"
            android:exported="false" />

        <!-- Le bouton « Arrêter » de la notification d'avancement d'un tour. -->
        <receiver
            android:name=".notifications.TurnStopReceiver"
            android:exported="false" />

        <!-- L'action « Reply » d'une notification de question (RemoteInput). -->
        <receiver
            android:name=".notifications.QuestionActionReceiver"
            android:exported="false" />

        <!--
          L'écran d'appel entrant : plein écran sur l'écran verrouillé, l'écran s'allume, on
          décroche ou on refuse. `excludeFromRecents` : un appel n'est pas une tâche qu'on retrouve
          dans le sélecteur. Il s'ouvre par-dessus le verrouillage (`showWhenLocked`).
        -->
        <activity
            android:name=".notifications.IncomingCallActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:excludeFromRecents="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:theme="@style/Theme.Onyx" />

        <!-- Le bouton « Refuser » d'un appel entrant (sans ouvrir l'écran). -->
        <receiver
            android:name=".notifications.CallActionReceiver"
            android:exported="false" />

