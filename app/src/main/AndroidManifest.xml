<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- Outils téléphone: chaque famille n'est demandée qu'au moment où on l'autorise. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />

    <!-- Verrouillage de l'app. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <!-- Les deux seuls habillages du compagnon Auto, lisibles par l'APK signé de la même clé. -->
    <permission
        android:name="com.onyx.app.permission.AUTO_SETTINGS"
        android:protectionLevel="signature" />

    <application
        android:name=".OnyxApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.Onyx">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Onyx">

            <!-- Le lanceur principal vit dans les activity-alias ci-dessous, pour permettre le
                 changement d'icône sans laisser plusieurs entrées Onyx sur l'écran d'accueil. -->

            <!-- Une question posée par l'assistant du téléphone. -->
            <intent-filter>
                <action android:name="android.intent.action.ASSIST" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

            <!-- App Actions: Gemini, et les raccourcis déclarés dans res/xml/shortcuts.xml. -->
            <intent-filter>
                <action android:name="com.onyx.app.action.ASK" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.onyx.app.action.VOICE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

            <!-- « Capture rapide »: une note à prendre, depuis un raccourci ou un pilotage du
                 téléphone. L'app s'ouvre sur l'écran de la note. -->
            <intent-filter>
                <action android:name="com.onyx.app.action.CAPTURE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

            <!-- Un texte partagé depuis n'importe quelle app arrive dans le composer. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>

            <!-- Une photo, un PDF, une vidéo ou un fichier partagé se joint au message: le PDF
                 s'ouvre ensuite dans le lecteur de l'app, l'image en plein écran, la vidéo dans
                 son lecteur. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>

            <!-- Un fichier ouvert depuis une autre app (Fichiers, galerie, lecteur de PDF). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" android:mimeType="image/*" />
                <data android:scheme="content" android:mimeType="video/*" />
                <data android:scheme="content" android:mimeType="application/pdf" />
                <data android:scheme="file" android:mimeType="image/*" />
                <data android:scheme="file" android:mimeType="video/*" />
                <data android:scheme="file" android:mimeType="application/pdf" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>

            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- Un alias par illustration. Un seul est actif; AppIconController les bascule. -->
        <activity-alias
            android:name=".launcher.FaceMist"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_face_mist"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_face_mist_round"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".launcher.Graphite"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_graphite"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_graphite_round"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".launcher.GraphiteBlock"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_graphite_block"
            android:label="@string/app_name"
