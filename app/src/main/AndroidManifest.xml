            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".launcher.SteelBlock"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_steel_block"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_steel_block_round"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".launcher.Mist"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_mist"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_mist_round"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".launcher.GraphiteFlat"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_graphite_flat"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_graphite_flat_round"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".launcher.GraphiteBlockFlat"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_graphite_block_flat"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_graphite_block_flat_round"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".launcher.SteelFlat"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_steel_flat"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_steel_flat_round"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".launcher.MistFlat"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_mist_flat"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_mist_flat_round"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".launcher.NavyBlock"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_navy_block"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_navy_block_round"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".launcher.Ink"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_ink"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_ink_round"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".launcher.PaperNavy"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_paper_navy"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_paper_navy_round"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".launcher.Gold"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_gold"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_gold_round"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".launcher.Classic"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_classic"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_classic_round"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>


        <!-- Le tour en cours, suivi dans la barre d'état (Live Update sur Android 16). -->
        <service
            android:name=".notifications.TurnService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Les boutons « Approve » / « Deny » d'une notification d'approbation. -->
        <receiver
            android:name=".notifications.ApprovalActionReceiver"
            android:exported="false" />

        <!-- L'action « Reply » d'une notification de question (RemoteInput). -->
        <receiver
            android:name=".notifications.QuestionActionReceiver"
            android:exported="false" />

        <!-- Partager un fichier téléchargé du serveur (il n'a pas d'éditeur sur le téléphone). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <provider
            android:name=".data.local.AutoSettingsProvider"
            android:authorities="com.onyx.app.auto_settings"
            android:exported="true"
            android:grantUriPermissions="false"
            android:permission="com.onyx.app.permission.AUTO_SETTINGS" />

        <receiver
            android:name=".widget.OnyxWidgetReceiver"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/onyx_widget_info" />
        </receiver>
    </application>

</manifest>
